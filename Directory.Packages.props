<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Bowire contract package. Also carries the mock-emitter contract
         types under Kuestenlogik.Bowire.Mocking since v0.2 — plugins no longer
         need a second reference to Kuestenlogik.Bowire.Mock for the emitter
         interface. During local development consume from
         ../Bowire/artifacts/packages (see nuget.config); release
         builds resolve the same id from nuget.org. -->
    <PackageVersion Include="Kuestenlogik.Bowire" Version="2.9.1" />

    <!-- DIS sandbox sample: an independent DIS v7 encoder, so the sandbox
         tests Bowire's decoder against code it does not share. -->
    <PackageVersion Include="OpenDisNet" Version="1.2.0" />

    <!-- Test-only -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
  </ItemGroup>
</Project>
